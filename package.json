{
  "name": "innovent-storyboard",
  "version": "1.0.0",
  "private": true,
  "description": "Innovent Professional Storyboard",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "preview:built": "node desktop/preview.cjs",
    "test:ui": "npm run build && node tests/ui-smoke.mjs && node --experimental-strip-types tests/ui-build1.mjs",
    "set-build": "node scripts/set-build.mjs"
  },
  "build": {
    "appId": "com.innoventsolutions.storyboard",
    "productName": "Innovent Professional Storyboard",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "src/project-format.js",
      "package.json",
      "src/build-info.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/innovent-icon.icns"
    },
    "fileAssociations": [
      {
        "ext": "issb",
        "name": "Innovent Professional Storyboard Project",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "issb": {
    "version": 1,
    "build": "10122026.2044",
    "buildFormat": "MMDDYYYY.HH24MI",
    "buildTimezone": "America/New_York"
  }
}
